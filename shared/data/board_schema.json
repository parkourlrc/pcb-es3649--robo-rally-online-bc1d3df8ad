{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["walls", "spaces", "x_dim", "y_dim", "display_name"],
  "properties": {
    "display_name": {
      "type": "string",
      "description": "the name of this board as it will be shown in game (post-loading)"
    },
    "walls": {
      "type": "object",
      "description": "a pair of arrays specifying where walls are positioned on the board",
      "required": ["horizontal_walls", "vertical_walls"],
      "properties": {
        "horizontal_walls": {
          "type": "array",
          "description": "Walls which run horizontally (prohibit vertical movement). They are indexed first from left to right, then from bottom to top",
          "maxItems": 15,
          "items": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": ["object", "null"],
              "properties": {
                "hi": {
                  "description": "the object present on the north side of the wall",
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["standard", "laser", "laser2", "laser3"]
                    },{
                      "type": "object",
                      "required": ["registers"],
                      "properties": {
                        "registers": {
                          "type": "array",
                          "description": "the registers on which the push panel activated",
                          "items": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  ]
                },
                "lo": {
                  "description": "the object present on the south side of the wall",
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["standard", "laser", "laser2", "laser3"]
                    },{
                      "type": "object",
                      "required": ["registers"],
                      "properties": {
                        "registers": {
                          "type": "array",
                          "description": "the registers on which the push panel activated",
                          "items": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "vertical_walls": {
          "type": "array",
          "description": "Walls which run vertically (prohibit horizontal movement). They are indexed first from left to right, then from bottom to top",
          "maxItems": 16,
          "items": {
            "type": "array",
            "maxItems": 15,
            "items": {
              "type": ["object", "null"],
              "properties": {
                "hi": {
                  "description": "the object present on the east side of the wall",
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["standard", "laser", "laser2", "laser3"]
                    },{
                      "type": "object",
                      "required": ["registers"],
                      "properties": {
                        "registers": {
                          "type": "array",
                          "description": "the registers on which the push panel activated",
                          "items": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  ]
                },
                "lo": {
                  "description": "the object present on the west side of the wall",
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["standard", "laser", "laser2", "laser3"]
                    },{
                      "type": "object",
                      "required": ["registers"],
                      "properties": {
                        "registers": {
                          "type": "array",
                          "description": "the registers on which the push panel activated",
                          "items": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "spaces": {
      "type": "array",
      "description": "The array of board spaces. It is indexed first from left to right, then from bottom to top",
      "maxItems": 15,
      "minItems": 3,
      "items": {
        "type": "array",
        "maxItems": 15,
        "minItems": 3,
        "items": {
          "type": "object",
          "description": "the properties properties of the space",
          "properties": {
            "type": {
              "description": "the type of space this is: conveyor, battery, pit, spawn etc.",
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["conv_F", "conv_L", "conv_R", "conv_RF", "conv_LF", "conv_LR", "conv_LRF", "conv2_F", "conv2_L", "conv2_R", "conv2_RF", "conv2_LF", "conv2_LR", "conv2_LRF", "gear_R", "gear_L", "pit", "battery"]
                },{
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "the UUID of this spawn point"
                    }
                  }
                }
              ]
            },
            "cover": {
              "description": "the type of cover this space has: checkpoint, scrambler, crusher, etc.",
              "oneOf": [
                {
                  "type": "object",
                  "required": ["number"],
                  "properties": {
                    "number": {
                      "type": "integer",
                      "description": "the number of this checkpoint"
                    }
                  }
                },{
                  "type":"object",
                  "required": ["registers"],
                  "properties": {
                    "registers": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "description": "the registers on which this crusher activates"
                      }
                    }
                  }
                },{
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "the UUID of this respawn point"
                    }
                  }
                },{
                  "type": "string",
                  "description": "which basic cover this is: scrambler",
                  "enum": ["scrambler"]
                }
              ]
            },
            "orientation": {
              "type": "string",
              "description": "The orientation of this space. This is important for spawn points and conveyors",
              "enum": ["N", "S", "E", "W"]
            },
            "cover_orientation": {
              "type": "string",
              "description": "The orientation of this spaces's cover. This is important for respawn points",
              "enum": ["N", "S", "E", "W"]
            }
          }
        }
      }
    },
    "x_dim": {
      "type": "integer",
      "description": "the number of spaces in the x dimension, which must coincide with the number of rows in the #spaces key."
    },
    "y_dim": {
      "type": "integer",
      "description": "the number of spaces in the y dimension, which must coincide with the length of a #spaces key entry."
    }
  }
}